<ui:UXML xmlns:ui="UnityEngine.UIElements" editor-extension-mode="False">
    <Style src="App.uss" />

    <ui:VisualElement name="app" class="app" picking-mode="Ignore">

        <!-- Fundal folosit doar în Editor (simulare), în locul imaginii camerei -->
        <ui:VisualElement name="editor-backdrop" class="fill backdrop hidden" picking-mode="Ignore" />

        <!-- 1. Splash -->
        <ui:VisualElement name="screen-splash" class="screen screen--paper">
            <ui:VisualElement class="safe center">
                <ui:VisualElement name="splash-logo" class="logo logo--big intro intro--scale">
                    <ui:Label text="3" class="logo__three" />
                    <ui:Label text="Times" class="logo__times" />
                </ui:VisualElement>
                <ui:VisualElement class="splash-taglines">
                    <ui:Label name="splash-line1" text="Un loc." class="splash-tagline intro" />
                    <ui:Label name="splash-line2" text="Trei timpuri." class="splash-tagline intro" />
                </ui:VisualElement>
                <ui:VisualElement class="splash-slider">
                    <ui:VisualElement name="splash-track" class="splash-track splash-track--hidden" />
                    <ui:VisualElement name="splash-knob" class="time-knob splash-knob knob--past fade-hidden">
                        <ui:VisualElement class="knob-core" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 2. Pornire (macheta „Pornire”) -->
        <ui:VisualElement name="screen-onboarding" class="screen screen--paper hidden">
            <ui:VisualElement class="hero-image" picking-mode="Ignore" />
            <ui:VisualElement class="safe">
                <ui:VisualElement class="topbar">
                    <ui:VisualElement class="logo">
                        <ui:Label text="3" class="logo__three" />
                        <ui:Label text="Times" class="logo__times" />
                    </ui:VisualElement>
                    <ui:Button name="onboarding-lang" text="RO" class="pill-btn" />
                </ui:VisualElement>
                <ui:VisualElement class="hero-spacer" picking-mode="Ignore" />
                <ui:Label text="Un loc.&#10;Trei timpuri." class="display" />
                <ui:Label text="Ridică telefonul spre Piața Victoriei și trage cursorul timpului." class="lead" />
                <ui:VisualElement class="modes-card">
                    <ui:VisualElement name="intro-past" class="mode-row intro">
                        <ui:VisualElement class="mode-icon mode-icon--past"><ui:VisualElement class="icon icon--past" /></ui:VisualElement>
                        <ui:VisualElement class="mode-text">
                            <ui:Label text="Trecut" class="mode-title mode-title--past" />
                            <ui:Label text="Vezi cum arăta piața acum un secol." class="mode-desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="intro-present" class="mode-row intro">
                        <ui:VisualElement class="mode-icon mode-icon--present"><ui:VisualElement class="icon icon--present" /></ui:VisualElement>
                        <ui:VisualElement class="mode-text">
                            <ui:Label text="Prezent" class="mode-title mode-title--present" />
                            <ui:Label text="Descoperă ce au simțit alții aici și lasă-ți propria urmă." class="mode-desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="intro-future" class="mode-row mode-row--last intro">
                        <ui:VisualElement class="mode-icon mode-icon--future"><ui:VisualElement class="icon icon--future" /></ui:VisualElement>
                        <ui:VisualElement class="mode-text">
                            <ui:Label text="Viitor" class="mode-title mode-title--future" />
                            <ui:Label text="Scrie un mesaj care se deschide doar aici, în ziua pe care o alegi tu." class="mode-desc" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>
                <ui:VisualElement class="grow" />
                <ui:Button name="onboarding-continue" text="Începe" class="btn btn--primary intro" />
                <ui:Label text="Camera o pornești doar când vrei tu." class="fineprint" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 3. Verificări -->
        <ui:VisualElement name="screen-checking" class="screen screen--paper hidden">
            <ui:VisualElement class="safe center">
                <ui:VisualElement name="checking-spinner" class="spinner" />
                <ui:Label name="checking-status" text="Pregătim aplicația…" class="lead text-center" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 4. Localizare (peste imaginea camerei) -->
        <ui:VisualElement name="screen-localizing" class="screen hidden" picking-mode="Ignore">
            <ui:VisualElement class="safe" picking-mode="Ignore">
                <ui:VisualElement class="grow" picking-mode="Ignore" />
                <ui:VisualElement class="sheet">
                    <ui:VisualElement class="row">
                        <ui:VisualElement name="localizing-spinner" class="spinner spinner--small" />
                        <ui:Label text="Se localizează…" class="title" />
                    </ui:VisualElement>
                    <ui:Label text="Îndreaptă telefonul spre clădirile din jur și mișcă-l încet de la stânga la dreapta." class="body" />
                    <ui:Label name="localizing-accuracy" text="Precizie: încă nu avem semnal" class="caption" />
                    <ui:VisualElement name="localizing-timeout" class="timeout hidden">
                        <ui:Label text="Durează mai mult decât de obicei. Apropie-te de clădiri sau ieși din umbra copacilor." class="body" />
                        <ui:VisualElement class="row">
                            <ui:Button name="localizing-retry" text="Mai încerc" class="btn btn--secondary grow" />
                            <ui:Button name="localizing-continue" text="Continuă oricum" class="btn btn--primary grow gap-left" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:Button name="localizing-cancel" text="Închide camera" class="btn btn--ghost" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 5. Eroare -->
        <ui:VisualElement name="screen-error" class="screen screen--paper hidden">
            <ui:VisualElement class="safe">
                <ui:VisualElement class="grow" />
                <ui:Label name="error-title" text="Titlu" class="display display--small" />
                <ui:Label name="error-message" text="Mesaj" class="lead" />
                <ui:VisualElement class="grow" />
                <ui:Button name="error-primary" text="Reîncearcă" class="btn btn--primary" />
                <ui:Button name="error-secondary" text="Reîncearcă" class="btn btn--ghost" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- 6. Ecranul principal (macheta „Prezent”) -->
        <ui:VisualElement name="screen-main" class="screen hidden" picking-mode="Ignore">
            <!-- Prinde atingerile din zona liberă a ecranului (pe urmele din AR) -->
            <ui:VisualElement name="tap-catcher" class="fill" />
            <ui:VisualElement name="past-tint" class="fill past-tint hidden" picking-mode="Ignore" />
            <!-- Doar în simulare (Editor): urmele salvate, desenate peste ilustrație -->
            <ui:VisualElement name="sim-traces" class="fill hidden" picking-mode="Ignore" />
            <ui:VisualElement class="fade-top" picking-mode="Ignore" />
            <ui:VisualElement class="fade-bottom" picking-mode="Ignore" />

            <ui:VisualElement class="safe" picking-mode="Ignore">
                <ui:VisualElement class="topbar" picking-mode="Ignore">
                    <ui:VisualElement class="logo" picking-mode="Ignore">
                        <ui:Label text="3" class="logo__three" picking-mode="Ignore" />
                        <ui:Label text="Times" class="logo__times" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row" picking-mode="Ignore">
                        <ui:Button name="camera-off" class="round-btn hidden">
                            <ui:VisualElement class="icon icon--camera-off" picking-mode="Ignore" />
                        </ui:Button>
                        <ui:Button name="menu-button" class="round-btn gap-left">
                            <ui:VisualElement class="menu-bars" picking-mode="Ignore">
                                <ui:VisualElement class="bar" picking-mode="Ignore" />
                                <ui:VisualElement class="bar bar--short" picking-mode="Ignore" />
                            </ui:VisualElement>
                            <!-- Notificări necitite -->
                            <ui:VisualElement name="menu-button-badge" class="menu-badge-dot hidden" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:VisualElement class="mode-head" picking-mode="Ignore">
                    <ui:Label name="mode-label" text="Prezent" class="mode-label" picking-mode="Ignore" />
                    <ui:Label name="mode-word" text="acum" class="mode-word" picking-mode="Ignore" />
                    <ui:VisualElement class="status" picking-mode="Ignore">
                        <ui:VisualElement name="status-dot" class="dot dot--none" picking-mode="Ignore" />
                        <ui:Label name="status-label" text="Se localizează…" class="caption" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- aici, deasupra, se văd camera și urmele în AR -->
                <ui:VisualElement class="grow" picking-mode="Ignore" />

                <!-- Camera oprită: invitație să pornești camera -->
                <ui:VisualElement name="camera-prompt" class="camera-card">
                    <ui:Label text="Vezi timpul prin cameră" class="title" />
                    <ui:Label name="camera-prompt-text" text="Urmele și capsulele apar peste locul în care ești." class="caption camera-card__text" />
                    <ui:Button name="camera-start" class="btn btn--primary camera-card__btn">
                        <ui:VisualElement class="icon icon--camera" picking-mode="Ignore" />
                        <ui:Label text="Pornește camera" class="btn__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:Label name="mode-hint" text="Atinge o urmă ca s-o deschizi." class="hint hidden" picking-mode="Ignore" />

                <ui:VisualElement class="actions">
                    <ui:Button name="action-map" class="round-btn round-btn--big">
                        <ui:VisualElement class="icon icon--map" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="action-primary" text="+ Lasă o urmă" class="btn btn--primary action-main" />
                    <ui:Button name="action-postcard" class="round-btn round-btn--big">
                        <ui:VisualElement class="icon icon--postcard" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <ui:VisualElement class="timebar">
                    <ui:VisualElement name="time-slider" class="time-slider">
                        <ui:VisualElement name="time-track" class="time-track" picking-mode="Ignore">
                            <ui:VisualElement class="year-dot year-dot--1900" picking-mode="Ignore" />
                            <ui:VisualElement class="year-dot year-dot--1918" picking-mode="Ignore" />
                            <ui:VisualElement class="year-dot year-dot--1989" picking-mode="Ignore" />
                            <ui:VisualElement name="time-knob" class="time-knob knob--present" picking-mode="Ignore">
                                <ui:VisualElement class="knob-core" picking-mode="Ignore" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="time-labels">
                        <ui:Button name="time-past" text="Trecut" class="time-label time-label--serif time-label--left" />
                        <ui:Button name="time-present" text="Prezent" class="time-label time-label--sans" />
                        <ui:Button name="time-future" text="Viitor" class="time-label time-label--serif time-label--right" />
                    </ui:VisualElement>
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Meniu -->
        <ui:VisualElement name="screen-menu" class="screen screen--paper hidden">
            <ui:VisualElement class="safe">
                <ui:VisualElement class="topbar">
                    <ui:Label text="Meniu" class="title title--big" />
                    <ui:Button name="menu-close" class="round-btn">
                        <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Button name="menu-account" class="list-item">
                    <ui:Label name="menu-account-label" text="Cont" class="list-item__text" picking-mode="Ignore" />
                    <ui:VisualElement class="icon icon--chevron" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="menu-notifications" class="list-item">
                    <ui:Label text="Notificări" class="list-item__text" picking-mode="Ignore" />
                    <ui:VisualElement class="row list-item__end" picking-mode="Ignore">
                        <ui:Label name="menu-notifications-badge" text="0" class="count-badge hidden" picking-mode="Ignore" />
                        <ui:VisualElement class="icon icon--chevron" picking-mode="Ignore" />
                    </ui:VisualElement>
                </ui:Button>
                <ui:Button name="menu-about" class="list-item">
                    <ui:Label text="Despre, surse și confidențialitate" class="list-item__text" picking-mode="Ignore" />
                    <ui:VisualElement class="icon icon--chevron" picking-mode="Ignore" />
                </ui:Button>
                <!-- Doar pentru teste; dispare când urmele ajung pe server -->
                <ui:Button name="menu-log" class="list-item">
                    <ui:Label text="Jurnal de test" class="list-item__text" picking-mode="Ignore" />
                    <ui:VisualElement class="icon icon--chevron" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="menu-postcards" class="list-item">
                    <ui:Label text="Cărțile mele poștale" class="list-item__text" picking-mode="Ignore" />
                    <ui:VisualElement class="icon icon--chevron" picking-mode="Ignore" />
                </ui:Button>
                <ui:Button name="menu-clear-traces" class="list-item">
                    <ui:Label text="Șterge urmele mele de test" class="list-item__text" picking-mode="Ignore" />
                </ui:Button>

                <!-- Serverul urmelor (la testele cu hotspot: IP-ul laptopului, de ex. 192.168.43.57) -->
                <ui:Label text="Server" class="field-label server-label" />
                <ui:VisualElement class="row">
                    <ui:TextField name="server-url" placeholder-text="ex. 192.168.43.57" class="server-input grow" />
                    <ui:Button name="server-save" text="Verifică" class="pill-btn gap-left" />
                </ui:VisualElement>
                <ui:Label name="server-status" text="" class="caption server-status" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Despre / Surse și confidențialitate -->
        <ui:VisualElement name="screen-about" class="screen screen--paper hidden">
            <ui:VisualElement class="safe">
                <ui:VisualElement class="topbar">
                    <ui:Button name="about-back" class="round-btn">
                        <ui:VisualElement class="icon icon--back" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:ScrollView class="grow">
                    <ui:Label text="Despre 3Times" class="display display--small" />
                    <ui:Label text="Aplicație de realitate augmentată care arată povestea locurilor: trecut, prezent și viitor. Prima versiune acoperă Piața Victoriei din Timișoara, de la Operă până la Catedrală." class="body section" />
                    <ui:Label text="Surse și licențe" class="title" />
                    <ui:Label text="Sursa și licența fiecărei fotografii și înregistrări istorice vor apărea aici, odată cu conținutul." class="body section" />
                    <ui:Label text="Harta: © OpenStreetMap contributors (openstreetmap.org/copyright), © CARTO." class="caption section" />
                    <ui:Label text="Confidențialitate" class="title" />
                    <ui:Label text="Aplicația folosește camera și locația telefonului. Imaginile camerei nu se salvează. Urmele pe care le lași păstrează locul în care le-ai lăsat și pot fi șterse oricând, la cerere." class="body section" />
                    <ui:Label text="Contul e opțional. Dacă îți faci unul, păstrăm doar emailul și parola (criptată, nu poate fi citită). Îl poți șterge oricând din Meniu → Cont, împreună cu toate urmele tale." class="body section" />
                    <ui:Label text="Ca să-ți propunem emoția, textul urmei (doar textul, fără locul ei sau alte date) e trimis serviciului Google Gemini. Emoția o poți schimba oricând." class="body section" />
                    <ui:Label text="Această aplicație folosește Google Play Services for AR (ARCore), oferit de Google LLC și guvernat de Politica de confidențialitate Google." class="caption section" />
                    <ui:Label text="Proiect Codesign Hardware/Software, Universitatea Politehnica Timișoara, 2026–2027." class="caption" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Notificări (de la server): de exemplu „urma ta a fost ștearsă de moderatori” -->
        <ui:VisualElement name="screen-notifications" class="screen screen--paper hidden">
            <ui:VisualElement class="safe">
                <ui:VisualElement class="topbar">
                    <ui:Button name="notifications-back" class="round-btn">
                        <ui:VisualElement class="icon icon--back" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label text="Notificări" class="title" />
                    <ui:VisualElement class="topbar-spacer" />
                </ui:VisualElement>
                <ui:Button name="notifications-read-all" text="Marchează tot ca citit" class="btn btn--ghost notifications-read-all hidden" />
                <ui:ScrollView class="grow">
                    <ui:Label name="notifications-empty" text="Nu ai notificări." class="caption notifications-empty hidden" />
                    <ui:VisualElement name="notifications-list" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Cont (opțional): autentificare / înregistrare cu email și parolă; după autentificare, contul -->
        <ui:VisualElement name="screen-account" class="screen screen--paper hidden">
            <ui:VisualElement class="safe">
                <ui:VisualElement class="topbar">
                    <ui:Button name="account-back" class="round-btn">
                        <ui:VisualElement class="icon icon--back" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label text="Cont" class="title" />
                    <ui:VisualElement class="topbar-spacer" />
                </ui:VisualElement>
                <ui:ScrollView class="grow">
                    <!-- Fără cont: „Intră în cont” sau „Cont nou” -->
                    <ui:VisualElement name="account-signed-out">
                        <ui:VisualElement class="segments account-tabs">
                            <ui:Button name="account-tab-login" text="Intră în cont" class="seg seg--active" />
                            <ui:Button name="account-tab-register" text="Cont nou" class="seg" />
                        </ui:VisualElement>
                        <ui:Label name="account-title" text="Bine ai revenit" class="display display--small account-title" />
                        <ui:Label name="account-intro" text="Intră cu emailul și parola contului tău." class="caption account-intro" />
                        <ui:Label name="account-server-note" text="Contul are nevoie de server: pune adresa lui în Meniu, la „Server”." class="caption account-note hidden" />

                        <ui:VisualElement name="account-names" class="row account-names hidden">
                            <ui:VisualElement class="grow account-name">
                                <ui:Label text="Prenume" class="field-label" />
                                <ui:TextField name="account-first-name" class="server-input" />
                            </ui:VisualElement>
                            <ui:VisualElement class="grow account-name gap-left">
                                <ui:Label text="Nume" class="field-label" />
                                <ui:TextField name="account-last-name" class="server-input" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                        <ui:Label text="Email" class="field-label" />
                        <ui:TextField name="account-email" placeholder-text="nume@exemplu.ro" class="server-input" />
                        <ui:Label text="Parolă" class="field-label" />
                        <ui:TextField name="account-password" class="server-input" />
                        <ui:Button name="account-forgot" text="Mi-am uitat parola" class="account-forgot" />

                        <!-- Doar la cont nou: cât de puternică e parola -->
                        <ui:VisualElement name="account-strength" class="strength hidden">
                            <ui:VisualElement class="row strength__bars">
                                <ui:VisualElement name="strength-1" class="strength__bar grow" />
                                <ui:VisualElement name="strength-2" class="strength__bar grow gap-small" />
                                <ui:VisualElement name="strength-3" class="strength__bar grow gap-small" />
                            </ui:VisualElement>
                            <ui:Label name="strength-label" text="" class="caption strength__label" />
                        </ui:VisualElement>

                        <ui:Label name="account-error" text="" class="caption account-error hidden" />
                        <ui:Button name="account-submit" text="Intră în cont" class="btn btn--primary account-submit" />
                        <ui:VisualElement class="account-divider" />
                        <ui:Button name="account-skip" text="Continuă fără cont" class="btn btn--secondary" />
                    </ui:VisualElement>

                    <!-- Codul de 6 cifre primit pe email: activarea contului nou sau parola nouă -->
                    <ui:VisualElement name="account-code" class="hidden">
                        <ui:Label name="account-code-title" text="Verifică-ți emailul" class="display display--small account-title" />
                        <ui:Label name="account-code-intro" text="" class="caption account-intro" />
                        <ui:Label text="Codul din email" class="field-label" />
                        <ui:TextField name="account-code-field" placeholder-text="123456" class="server-input account-code-input" />
                        <ui:VisualElement name="account-new-password-box" class="hidden">
                            <ui:Label text="Parola nouă" class="field-label" />
                            <ui:TextField name="account-new-password" class="server-input" />
                            <ui:Label name="account-new-strength" text="" class="caption strength__label hidden" />
                        </ui:VisualElement>
                        <ui:Label name="account-code-error" text="" class="caption account-error hidden" />
                        <ui:Button name="account-code-submit" text="Activează contul" class="btn btn--primary account-submit" />
                        <ui:Button name="account-code-resend" text="Trimite alt cod" class="btn btn--ghost" />
                        <ui:Button name="account-code-cancel" text="Înapoi" class="btn btn--ghost" />
                    </ui:VisualElement>

                    <!-- Cu cont -->
                    <ui:VisualElement name="account-signed-in" class="hidden">
                        <ui:Label text="Contul tău" class="display display--small account-title" />
                        <ui:VisualElement class="account-card">
                            <ui:Label name="account-current-email" text="" class="title account-card__email" />
                            <ui:Label name="account-meta" text="" class="caption" />
                        </ui:VisualElement>
                        <ui:Label text="Urmele pe care le lași acum intră în cont. Le găsești pe hartă, la „Harta mea”, de pe orice telefon pe care intri în cont." class="body account-intro" />
                        <ui:Button name="account-logout" text="Deconectează-te" class="btn btn--secondary" />
                        <ui:VisualElement class="account-divider" />
                        <ui:Button name="account-delete" text="Șterge contul și urmele mele" class="btn btn--danger" />
                        <ui:VisualElement name="account-confirm" class="account-confirm hidden">
                            <ui:Label text="Se șterg contul și toate urmele tale, cu pozele și vocile lor. Nu se poate anula." class="body" />
                            <ui:Label name="account-delete-error" text="" class="caption account-error hidden" />
                            <ui:VisualElement class="row account-confirm__actions">
                                <ui:Button name="account-delete-cancel" text="Renunță" class="btn btn--secondary grow" />
                                <ui:Button name="account-delete-confirm" text="Da, șterge tot" class="btn btn--danger-solid grow gap-left" />
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Harta urmelor (fundal CARTO Positron; cheia în Assets/Resources/MapConfig.json, local) -->
        <ui:VisualElement name="screen-map" class="screen screen--paper hidden">
            <ui:VisualElement name="map-view" class="fill map-view">
                <ui:VisualElement name="map-tiles" class="fill" picking-mode="Ignore" />
                <ui:VisualElement name="map-markers" class="fill" picking-mode="Ignore" />
                <ui:VisualElement name="map-me" class="map-me hidden" picking-mode="Ignore" />
            </ui:VisualElement>
            <ui:VisualElement class="fill safe" picking-mode="Ignore">
                <ui:VisualElement class="topbar" picking-mode="Ignore">
                    <ui:Button name="map-back" class="round-btn">
                        <ui:VisualElement class="icon icon--back" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label name="map-status" text="" class="map-status" picking-mode="Ignore" />
                    <ui:VisualElement class="topbar-spacer" picking-mode="Ignore" />
                </ui:VisualElement>
                <!-- „Harta mea”: doar urmele contului tău (doar cu cont) -->
                <ui:VisualElement class="segments map-tabs">
                    <ui:Button name="map-tab-all" text="Urme" class="seg seg--active" />
                    <ui:Button name="map-tab-mine" text="Harta mea" class="seg" />
                </ui:VisualElement>
                <ui:VisualElement class="grow" picking-mode="Ignore" />
                <ui:VisualElement class="map-controls" picking-mode="Ignore">
                    <ui:Button name="map-zoom-in" text="+" class="round-btn map-control" />
                    <ui:Button name="map-zoom-out" text="−" class="round-btn map-control" />
                    <ui:Button name="map-locate" class="round-btn map-control">
                        <ui:VisualElement class="map-locate-dot" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:Label text="© OpenStreetMap contributors, © CARTO" class="map-attribution" picking-mode="Ignore" />
                <!-- Mai multe urme în același loc: le arătăm mari, într-o fereastră; atingerea uneia o deschide în card -->
                <ui:VisualElement name="map-group" class="map-card map-group hidden">
                    <ui:VisualElement class="row">
                        <ui:VisualElement class="grow" picking-mode="Ignore">
                            <ui:Label name="map-group-title" text="" class="title" />
                            <ui:Label text="Atinge o urmă ca s-o vezi." class="caption" />
                        </ui:VisualElement>
                        <ui:Button name="map-group-close" class="round-btn">
                            <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:ScrollView name="map-group-scroll" class="map-group__scroll">
                        <ui:VisualElement name="map-group-grid" class="map-group__grid" />
                    </ui:ScrollView>
                </ui:VisualElement>
                <ui:VisualElement name="map-card" class="map-card hidden">
                    <ui:VisualElement class="row">
                        <ui:VisualElement name="map-card-shape" class="map-card__holder" picking-mode="Ignore" />
                        <ui:VisualElement class="grow map-card__text" picking-mode="Ignore">
                            <ui:Label name="map-card-title" text="bucurie" class="detail-emotion" />
                            <ui:Label name="map-card-kind" text="" class="caption" />
                        </ui:VisualElement>
                        <ui:Button name="map-card-close" class="round-btn">
                            <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                        </ui:Button>
                    </ui:VisualElement>
                    <ui:Label name="map-card-distance" text="" class="body map-card__distance" />
                    <ui:Label name="map-card-hint" text="" class="caption" />
                    <!-- Mai multe urme în același loc: le răsfoiești -->
                    <ui:VisualElement name="map-card-nav" class="row map-card__nav hidden">
                        <ui:Button name="map-card-prev" text="‹" class="round-btn map-card__step" />
                        <ui:Label name="map-card-index" text="" class="caption grow map-card__index" />
                        <ui:Button name="map-card-next" text="›" class="round-btn map-card__step" />
                    </ui:VisualElement>
                    <ui:Button name="map-card-open" text="Deschide" class="btn btn--primary map-card__open hidden" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Cărțile mele poștale -->
        <ui:VisualElement name="screen-postcards" class="screen screen--paper hidden">
            <ui:VisualElement class="safe">
                <ui:VisualElement class="topbar">
                    <ui:Button name="postcards-back" class="round-btn">
                        <ui:VisualElement class="icon icon--back" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label text="Cărțile mele poștale" class="title" />
                    <ui:VisualElement class="topbar-spacer" />
                </ui:VisualElement>
                <ui:Label name="postcards-empty" text="Nicio carte poștală încă. Pornește camera și apasă butonul din dreapta jos." class="caption postcards-empty" />
                <ui:ScrollView class="grow">
                    <ui:VisualElement name="postcards-grid" class="postcards-grid" />
                </ui:ScrollView>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Jurnal de test (temporar, pentru testele de ancorare) -->
        <ui:VisualElement name="screen-log" class="screen screen--paper hidden">
            <ui:VisualElement class="safe">
                <ui:VisualElement class="topbar">
                    <ui:Button name="log-back" class="round-btn">
                        <ui:VisualElement class="icon icon--back" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Label text="Jurnal de test" class="title" />
                    <ui:VisualElement class="topbar-spacer" />
                </ui:VisualElement>
                <ui:Label text="Aplicația notează singură localizările și urmele. Cele mai noi sunt sus." class="caption log-intro" />
                <ui:VisualElement class="log-clock">
                    <ui:Label text="Ceasul de test" class="log-clock-title" />
                    <ui:Label name="log-clock-text" text="Azi." class="caption log-clock-text" />
                    <ui:Button name="log-clock" text="Peste un an" class="btn btn--secondary log-clock-btn" />
                </ui:VisualElement>
                <ui:ScrollView class="grow log-scroll">
                    <ui:Label name="log-text" text="" class="log-text" />
                </ui:ScrollView>
                <ui:VisualElement class="row log-actions">
                    <ui:Button name="log-clear" text="Golește" class="btn btn--secondary grow" />
                    <ui:Button name="log-copy" text="Copiază tot" class="btn btn--dark grow gap-left" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Lasă o urmă (foaie care urcă de jos) -->
        <ui:VisualElement name="trace-overlay" class="fill hidden">
            <ui:Button name="trace-dim" class="sheet-dim sheet-dim--hidden" />
            <ui:VisualElement name="trace-sheet" class="trace-sheet trace-sheet--closed">
                <ui:VisualElement class="sheet-handle" />
                <ui:VisualElement class="topbar">
                    <ui:Label name="trace-title" text="Lasă o urmă" class="title title--big" />
                    <ui:Button name="trace-close" class="round-btn">
                        <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Conținutul foii se derulează; butonul de jos rămâne mereu vizibil -->
                <ui:ScrollView name="trace-scroll" class="trace-scroll" vertical-scroller-visibility="Hidden" horizontal-scroller-visibility="Hidden">
                <ui:VisualElement class="segments">
                    <ui:Button name="trace-type-text" text="Text" class="seg seg--active" />
                    <ui:Button name="trace-type-photo" text="Poză" class="seg" />
                    <ui:Button name="trace-type-voice" text="Voce" class="seg" />
                </ui:VisualElement>

                <!-- Poza: se face pe loc, fără galerie -->
                <ui:VisualElement name="trace-photo-panel" class="media-panel hidden">
                    <ui:VisualElement name="trace-photo-pick" class="row">
                        <ui:Button name="photo-selfie" text="Selfie" class="btn btn--secondary grow media-btn" />
                        <ui:Button name="photo-place" text="Locul" class="btn btn--secondary grow gap-left media-btn" />
                        <ui:Button name="photo-traces" text="Cu urmele" class="btn btn--secondary grow gap-left media-btn" />
                    </ui:VisualElement>
                    <ui:VisualElement name="trace-photo-done" class="row hidden">
                        <ui:VisualElement name="trace-photo-thumb" class="photo-thumb" />
                        <ui:VisualElement class="grow media-info">
                            <ui:Label name="trace-photo-label" text="Selfie" class="media-title" />
                            <ui:Button name="trace-photo-redo" text="Refă poza" class="pill-btn media-redo" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Vocea: cel mult 30 de secunde -->
                <ui:VisualElement name="trace-voice-panel" class="media-panel hidden">
                    <ui:Button name="voice-record" text="Înregistrează (cel mult 30 s)" class="btn btn--secondary voice-record" />
                    <ui:VisualElement name="trace-voice-done" class="row hidden">
                        <ui:Button name="voice-play" text="Ascultă" class="btn btn--secondary grow" />
                        <ui:Label name="voice-duration" text="0:00" class="media-title voice-duration" />
                        <ui:Button name="voice-redo" text="Refă" class="pill-btn" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Label name="trace-text-label" text="Mesajul tău" class="field-label" />
                <ui:TextField name="trace-text" multiline="true" max-length="280" placeholder-text="Ce s-a întâmplat aici?" class="trace-input" />

                <ui:Label text="Cum te simți?" class="field-label" />
                <ui:VisualElement class="chips">
                    <ui:Button name="chip-0" class="chip">
                        <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                        <ui:Label text="bucurie" class="chip__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="chip-1" class="chip">
                        <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                        <ui:Label text="tristețe" class="chip__label" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="chip-2" class="chip">
                        <ui:VisualElement class="chip__icon" picking-mode="Ignore" />
                        <ui:Label text="dor" class="chip__label" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>

                <!-- Altă emoție, scrisă de utilizator; AI-ul îi alege forma -->
                <ui:VisualElement class="row emotion-custom">
                    <ui:TextField name="emotion-custom" max-length="30" placeholder-text="Altă emoție…" class="server-input grow" />
                    <ui:Button name="emotion-custom-apply" text="Alege" class="pill-btn gap-left" />
                </ui:VisualElement>

                <ui:Label name="trace-suggestion" text="Scrie mesajul și îți propunem o emoție." class="caption suggestion" />

                <ui:VisualElement class="segments">
                    <ui:Button name="intensity-0" text="încet" class="seg" />
                    <ui:Button name="intensity-1" text="mediu" class="seg seg--active" />
                    <ui:Button name="intensity-2" text="puternic" class="seg" />
                </ui:VisualElement>

                <!-- Doar la capsule: data deschiderii și cine o poate deschide -->
                <ui:VisualElement name="capsule-panel" class="capsule-panel hidden">
                    <ui:Label text="Când se deschide?" class="field-label" />
                    <ui:VisualElement class="segments capsule-presets">
                        <ui:Button name="capsule-preset-test" text="2 min" class="seg hidden" />
                        <ui:Button name="capsule-preset-0" text="o lună" class="seg" />
                        <ui:Button name="capsule-preset-1" text="un an" class="seg seg--active" />
                        <ui:Button name="capsule-preset-2" text="5 ani" class="seg" />
                        <ui:Button name="capsule-preset-3" text="10 ani" class="seg" />
                    </ui:VisualElement>
                    <ui:VisualElement class="row capsule-date">
                        <ui:VisualElement class="row capsule-step">
                            <ui:Button name="capsule-day-down" text="‹" class="capsule-arrow" />
                            <ui:Label name="capsule-day" text="1" class="capsule-value" />
                            <ui:Button name="capsule-day-up" text="›" class="capsule-arrow" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row capsule-step capsule-step--wide">
                            <ui:Button name="capsule-month-down" text="‹" class="capsule-arrow" />
                            <ui:Label name="capsule-month" text="ianuarie" class="capsule-value" />
                            <ui:Button name="capsule-month-up" text="›" class="capsule-arrow" />
                        </ui:VisualElement>
                        <ui:VisualElement class="row capsule-step">
                            <ui:Button name="capsule-year-down" text="‹" class="capsule-arrow" />
                            <ui:Label name="capsule-year" text="2027" class="capsule-value" />
                            <ui:Button name="capsule-year-up" text="›" class="capsule-arrow" />
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement class="segments capsule-visibility">
                        <ui:Button name="capsule-public" text="Pentru oricine" class="seg seg--active" />
                        <ui:Button name="capsule-personal" text="Doar pentru mine" class="seg" />
                    </ui:VisualElement>
                    <ui:Label name="capsule-note" text="Se deschide doar aici, după data aleasă." class="caption suggestion" />
                </ui:VisualElement>

                <ui:Button name="trace-year" class="year-row">
                    <ui:VisualElement name="trace-year-check" class="year-check year-check--on" picking-mode="Ignore">
                        <ui:VisualElement class="year-tick" picking-mode="Ignore" />
                    </ui:VisualElement>
                    <ui:Label name="trace-year-label" text="Pune-o și în capsula anului" class="year-label" picking-mode="Ignore" />
                </ui:Button>

                <ui:VisualElement name="trace-preview" class="trace-preview">
                    <ui:VisualElement name="trace-shape" class="trace-shape trace-shape--1 shape--joy-1" />
                </ui:VisualElement>
                </ui:ScrollView>

                <ui:Button name="trace-submit" text="Lasă urma aici" class="btn btn--primary trace-submit" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Ecranul unei capsule (cât se umple sau până la data deschiderii) -->
        <ui:VisualElement name="capsule-overlay" class="fill hidden">
            <ui:Button name="capsule-dim" class="sheet-dim sheet-dim--hidden" />
            <ui:VisualElement name="capsule-card" class="detail-card detail-card--closed">
                <ui:VisualElement class="row">
                    <ui:VisualElement name="capsule-card-icon" class="detail-shape" />
                    <ui:Label name="capsule-card-title" text="Capsulă a timpului" class="detail-emotion capsule-card-title" />
                </ui:VisualElement>
                <ui:Label name="capsule-card-count" text="" class="detail-text" />
                <ui:Label name="capsule-card-text" text="" class="caption" />
                <ui:Button name="capsule-card-add" text="Pune o urmă în capsulă" class="btn btn--primary capsule-card-btn" />
                <ui:VisualElement class="row detail-actions">
                    <ui:Button name="capsule-card-seal" text="Sigilează acum" class="btn btn--secondary grow" />
                    <ui:Button name="capsule-card-close" text="Închide" class="btn btn--dark grow gap-left" />
                </ui:VisualElement>
                <ui:Button name="capsule-card-remove-mine" text="Scoate urmele mele" class="btn btn--ghost" />
                <ui:Button name="capsule-card-delete" text="Șterge capsula" class="btn btn--ghost" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Ecranul unei urme -->
        <ui:VisualElement name="detail-overlay" class="fill hidden">
            <ui:Button name="detail-dim" class="sheet-dim sheet-dim--hidden" />
            <ui:VisualElement name="detail-card" class="detail-card detail-card--closed">
                <ui:VisualElement class="row">
                    <ui:VisualElement name="detail-shape" class="detail-shape shape--joy-1" />
                    <ui:Label name="detail-emotion" text="bucurie" class="detail-emotion detail-emotion--joy" />
                </ui:VisualElement>
                <ui:VisualElement name="detail-photo" class="detail-photo hidden" />
                <ui:VisualElement name="detail-voice" class="row detail-voice hidden">
                    <ui:Button name="detail-play" text="Ascultă" class="btn btn--secondary grow" />
                    <ui:Label name="detail-duration" text="0:00" class="media-title voice-duration" />
                </ui:VisualElement>
                <ui:Label name="detail-text" text="" class="detail-text" />
                <ui:Label name="detail-meta" text="" class="caption" />
                <ui:VisualElement name="detail-actions" class="row detail-actions">
                    <ui:Button name="detail-report" text="Raportează" class="btn btn--secondary grow" />
                    <ui:Button name="detail-close" text="Închide" class="btn btn--dark grow gap-left" />
                </ui:VisualElement>
                <ui:Button name="detail-delete" text="Șterge urma mea" class="btn btn--ghost" />
                <!-- La „Raportează”: de ce (motivul ajunge la admin) -->
                <ui:VisualElement name="detail-reasons" class="detail-reasons hidden">
                    <ui:Label text="De ce o raportezi?" class="title detail-reasons__title" />
                    <ui:Button name="detail-reason-offensive" text="Jignitoare sau urâtă" class="btn btn--secondary detail-reason" />
                    <ui:Button name="detail-reason-spam" text="Spam sau reclamă" class="btn btn--secondary detail-reason" />
                    <ui:Button name="detail-reason-personal" text="Date personale despre cineva" class="btn btn--secondary detail-reason" />
                    <ui:Button name="detail-reason-other" text="Altceva" class="btn btn--secondary detail-reason" />
                    <ui:Button name="detail-reason-cancel" text="Renunță" class="btn btn--ghost" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Time postcard: cartea poștală (rama vie, la creare; imaginea salvată, din colecție) -->
        <ui:VisualElement name="postcard-overlay" class="fill hidden">
            <ui:VisualElement class="fill postcard-dim" />
            <ui:VisualElement class="fill safe postcard-layout" picking-mode="Ignore">
                <ui:VisualElement class="topbar" picking-mode="Ignore">
                    <ui:VisualElement class="topbar-spacer" picking-mode="Ignore" />
                    <ui:Button name="postcard-close" class="round-btn">
                        <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                    </ui:Button>
                </ui:VisualElement>
                <ui:VisualElement class="grow center" picking-mode="Ignore">
                    <ui:VisualElement name="postcard-card" class="postcard-card">
                        <ui:VisualElement name="postcard-photo" class="postcard-photo" />
                        <ui:VisualElement class="row postcard-caption">
                            <ui:VisualElement class="grow">
                                <ui:Label name="postcard-word" text="acum" class="postcard-word" />
                                <ui:Label name="postcard-place" text="" class="postcard-meta" />
                                <ui:Label name="postcard-date" text="" class="postcard-meta" />
                            </ui:VisualElement>
                            <ui:VisualElement class="postcard-right">
                                <ui:VisualElement name="postcard-emotions" class="row postcard-emotions" />
                                <ui:Label name="postcard-emotions-label" text="" class="postcard-meta postcard-count" />
                                <ui:VisualElement class="logo postcard-logo">
                                    <ui:Label text="3" class="logo__three" />
                                    <ui:Label text="Times" class="logo__times" />
                                </ui:VisualElement>
                            </ui:VisualElement>
                        </ui:VisualElement>
                    </ui:VisualElement>
                    <ui:VisualElement name="postcard-saved" class="postcard-saved hidden" />
                </ui:VisualElement>
                <ui:VisualElement class="row postcard-actions">
                    <ui:Button name="postcard-share" text="Trimite" class="btn btn--primary grow" />
                    <ui:Button name="postcard-save" text="În galerie" class="btn btn--secondary grow gap-left" />
                </ui:VisualElement>
                <ui:Button name="postcard-delete" text="Șterge din aplicație" class="btn btn--ghost hidden" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Fotografierea unei urme (selfie / locul / locul cu urmele) -->
        <ui:VisualElement name="capture-overlay" class="fill hidden">
            <ui:VisualElement name="capture-preview-frame" class="fill capture-frame hidden" picking-mode="Ignore" />
            <ui:VisualElement class="capture-bar">
                <ui:Label name="capture-hint" text="" class="capture-hint" />
                <ui:VisualElement class="row capture-controls">
                    <ui:Button name="capture-cancel" class="round-btn round-btn--big">
                        <ui:VisualElement class="icon icon--close" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:Button name="capture-shutter" class="capture-shutter">
                        <ui:VisualElement class="capture-shutter__inner" picking-mode="Ignore" />
                    </ui:Button>
                    <ui:VisualElement class="capture-spacer" />
                </ui:VisualElement>
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- Mesaj scurt (toast) -->
        <ui:Label name="toast" class="toast hidden" picking-mode="Ignore" />
    </ui:VisualElement>
</ui:UXML>
