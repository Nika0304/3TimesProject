/* 3Times: stilurile interfeței (direcția „Direcția aleasă” din canvas).
   Dimensiunile sunt în px de machetă, pentru rezoluția de referință 390 × 844 (Panel Settings). */

:root {
    --bg: #F4F5FB;
    --surface: #FFFFFF;
    --line: #E4E2EF;
    --ink: #1F3A5F;
    --muted: #6B6785;
    --coral: #FF8A6E;
    --coral-pressed: #F27A5E;
    --on-coral: #2B1712;
    --logo-times: #E0664B;
    --green: #1E7A64;

    --past: #8A6233;
    --past-icon: #B98A52;
    --past-tint: #F6E9D7;
    --present: #C24F35;
    --present-icon: #E0674C;
    --present-tint: #FFE4DC;
    --future: #1E7A64;
    --future-icon: #2F9C82;
    --future-tint: #DDF3EC;

    --good: #3FBF8F;
    --low: #F2B33D;
    --none: #B8B5C9;
    --lilac: #9C78E3;
    --peach-soft: #FFF3EC;
    --peach-line: #FAE0D4;
}

/* ---------- fonturi ---------- */

.app,
.f-body {
    -unity-font: url("Fonts/Figtree-Regular.ttf");
    -unity-font-definition: initial;
}
.f-semi {
    -unity-font: url("Fonts/Figtree-SemiBold.ttf");
    -unity-font-definition: initial;
}
.f-bold,
.btn,
.logo__three,
.mode-label,
.time-label--sans,
.pill-btn {
    -unity-font: url("Fonts/Figtree-ExtraBold.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}
.f-serif,
.display,
.title,
.mode-word,
.mode-title,
.splash-tagline {
    -unity-font: url("Fonts/Fraunces-Medium.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}
.f-italic,
.logo__times,
.time-label--serif {
    -unity-font: url("Fonts/Fraunces-Italic.ttf");
    -unity-font-definition: initial;
    -unity-font-style: normal;
}

/* ---------- structură ---------- */

.app {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    color: var(--ink);
}

.fill {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}

.screen {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
}
.screen--paper { background-color: var(--bg); }

/* UIRouter adaugă aici zona sigură (notch, bara de jos) peste marginea de bază. */
.safe {
    flex-grow: 1;
    flex-direction: column;
    padding: 20px;
}

.hidden { display: none; }
.grow { flex-grow: 1; }
.center { justify-content: center; align-items: center; }
.row { flex-direction: row; align-items: center; }
.gap-left { margin-left: 10px; }
.text-center { -unity-text-align: middle-center; }

.backdrop {
    background-image: url("Images/square-full.png");
    -unity-background-scale-mode: scale-and-crop;
}

/* ---------- logo ---------- */

.logo { flex-direction: row; align-items: flex-end; }
.logo__three { font-size: 26px; color: var(--ink); padding: 0; margin: 0; }
.logo__times { font-size: 26px; color: var(--logo-times); padding: 0; margin: 0 0 0 1px; }
.logo--big .logo__three,
.logo--big .logo__times { font-size: 64px; }

.splash-taglines { flex-direction: row; margin-top: 12px; }
.splash-tagline { font-size: 22px; color: var(--muted); margin: 0 4px; padding: 0; }

.splash-slider { width: 220px; height: 34px; margin-top: 34px; justify-content: center; }
.splash-track {
    height: 6px;
    width: 100%;
    border-radius: 3px;
    background-image: url("Images/track.png");
    -unity-background-scale-mode: stretch-to-fill;
    transition-property: width;
    transition-duration: 0.9s;
    transition-timing-function: ease-in-out-sine;
}
.splash-track--hidden { width: 0; }
.time-knob.splash-knob {
    left: 0%;
    top: 0;
    transition-property: left, opacity, border-color;
    transition-duration: 1.1s, 0.3s, 0.6s;
    transition-timing-function: ease-out-cubic, ease-out-cubic, linear;
}
.time-knob.splash-knob .knob-core { transition-property: background-color; transition-duration: 0.6s; }

/* ---------- text ---------- */

.display {
    font-size: 42px;
    color: var(--ink);
    white-space: normal;
    margin: 0 0 10px 0;
    padding: 0;
}
.display--small { font-size: 32px; color: var(--ink); }

.title { font-size: 22px; color: var(--ink); margin: 0; padding: 0; }
.title--big { font-size: 28px; }

.lead {
    font-size: 16px;
    color: var(--muted);
    white-space: normal;
    margin: 0 0 16px 0;
    padding: 0;
}

.body {
    font-size: 15px;
    color: var(--ink);
    white-space: normal;
    margin: 8px 0;
    padding: 0;
}

.caption {
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
    margin: 0;
    padding: 0;
}

.section { margin-bottom: 24px; }

.fineprint {
    font-size: 12px;
    color: var(--muted);
    -unity-text-align: middle-center;
    margin-top: 10px;
}

/* ---------- pornire ---------- */

.hero-image {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 340px;
    background-image: url("Images/square.png");
    -unity-background-scale-mode: scale-and-crop;
}
.hero-spacer { height: 238px; flex-shrink: 1; }

.topbar {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 48px;
}

.modes-card {
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 22px;
    margin-top: 4px;
}

.mode-row {
    flex-direction: row;
    align-items: flex-start;
    padding: 13px 16px;
    border-bottom-width: 1px;
    border-color: var(--line);
}
.mode-row--last { border-bottom-width: 0; }

.mode-icon {
    width: 40px;
    height: 40px;
    border-radius: 20px;
    align-items: center;
    justify-content: center;
    margin-right: 14px;
    flex-shrink: 0;
}
.mode-icon--past { background-color: var(--past-tint); }
.mode-icon--present { background-color: var(--present-tint); }
.mode-icon--future { background-color: var(--future-tint); }

.mode-text { flex-shrink: 1; flex-grow: 1; }
.mode-title { font-size: 19px; margin: 0; padding: 0; }
.mode-title--past { color: var(--past); }
.mode-title--present { color: var(--present); }
.mode-title--future { color: var(--future); }
.mode-desc { font-size: 14px; color: var(--muted); white-space: normal; margin: 2px 0 0 0; padding: 0; }

/* ---------- pictograme (PNG albe, colorate prin tint) ---------- */

.icon {
    width: 20px;
    height: 20px;
    -unity-background-scale-mode: scale-to-fit;
    -unity-background-image-tint-color: var(--ink);
}
.icon--map      { background-image: url("Images/Icons/icon-map.png"); }
.icon--postcard { background-image: url("Images/Icons/icon-postcard.png"); }
.icon--close    { background-image: url("Images/Icons/icon-close.png"); }
.icon--back     { background-image: url("Images/Icons/icon-back.png"); }
.icon--chevron  { background-image: url("Images/Icons/icon-chevron.png"); -unity-background-image-tint-color: var(--muted); width: 18px; height: 18px; }
.icon--past     { background-image: url("Images/Icons/icon-past.png"); -unity-background-image-tint-color: var(--past-icon); width: 18px; height: 18px; }
.icon--present  { background-image: url("Images/Icons/icon-present.png"); -unity-background-image-tint-color: var(--present-icon); width: 18px; height: 18px; }
.icon--camera     { background-image: url("Images/Icons/icon-camera.png"); -unity-background-image-tint-color: var(--on-coral); }
.icon--camera-off { background-image: url("Images/Icons/icon-camera-off.png"); }
.icon--future   { background-image: url("Images/Icons/icon-future.png"); -unity-background-image-tint-color: var(--future-icon); width: 18px; height: 18px; }

/* ---------- butoane ---------- */

.btn,
.btn:hover {
    height: 54px;
    margin: 0;
    padding: 0 20px;
    border-width: 0;
    border-radius: 27px;
    font-size: 16px;
    -unity-text-align: middle-center;
    background-color: var(--surface);
    color: var(--ink);
}

.btn--primary,
.btn--primary:hover {
    background-color: var(--coral);
    color: var(--on-coral);
}
.btn--primary:active { background-color: var(--coral-pressed); }

.btn--secondary,
.btn--secondary:hover {
    background-color: var(--surface);
    color: var(--ink);
    border-width: 1px;
    border-color: var(--line);
}
.btn--secondary:active { background-color: var(--bg); }

/* „Lasă o urmă” când camera e oprită: un singur buton corai pe ecran („Pornește camera”). */
.btn--muted,
.btn--muted:hover {
    background-color: var(--surface);
    color: var(--ink);
    border-width: 1px;
    border-color: var(--line);
}
.btn--muted:active { background-color: var(--bg); }

.btn--ghost,
.btn--ghost:hover,
.btn--ghost:active {
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
    margin-top: 6px;
}

.pill-btn,
.pill-btn:hover,
.pill-btn:active {
    height: 36px;
    margin: 0;
    padding: 0 14px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 18px;
    background-color: rgba(255, 255, 255, 0.85);
    color: var(--ink);
    font-size: 13px;
}

.round-btn,
.round-btn:hover {
    width: 44px;
    height: 44px;
    margin: 0;
    padding: 0;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 22px;
    background-color: rgba(255, 255, 255, 0.9);
    align-items: center;
    justify-content: center;
}
.round-btn:active { background-color: var(--bg); }
.round-btn--big { width: 52px; height: 52px; border-radius: 26px; flex-shrink: 0; }

.menu-bars { width: 18px; height: 9px; justify-content: space-between; }
.bar { height: 2px; width: 18px; border-radius: 1px; background-color: var(--ink); }
.bar--short { width: 12px; align-self: flex-end; }

/* ---------- invitația de a porni camera ---------- */

.camera-card {
    background-color: rgba(255, 255, 255, 0.94);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 24px;
    padding: 18px;
    margin-bottom: 14px;
}
.camera-card__text { margin: 4px 0 14px 0; }
.camera-card__btn,
.camera-card__btn:hover {
    flex-direction: row;
    justify-content: center;
    align-items: center;
}
.btn__label {
    -unity-font: url("Fonts/Figtree-ExtraBold.ttf");
    -unity-font-definition: initial;
    font-size: 16px;
    color: var(--on-coral);
    margin: 0 0 0 8px;
    padding: 0;
}

/* ---------- încărcare ---------- */

.spinner {
    width: 56px;
    height: 56px;
    border-radius: 28px;
    border-width: 5px;
    border-color: var(--line);
    border-top-color: var(--coral);
    margin-bottom: 24px;
}
.spinner--small {
    width: 28px;
    height: 28px;
    border-radius: 14px;
    border-width: 3px;
    margin: 0 12px 0 0;
}

/* ---------- localizare ---------- */

.sheet {
    background-color: var(--surface);
    border-radius: 28px;
    padding: 22px;
}
.timeout { margin-top: 12px; }

/* ---------- ecranul principal ---------- */

.past-tint { background-color: rgba(196, 150, 96, 0.32); }

.fade-top {
    position: absolute;
    left: 0; right: 0; top: 0;
    height: 230px;
    background-image: url("Images/fade-top.png");
    -unity-background-scale-mode: stretch-to-fill;
}
.fade-bottom {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 300px;
    background-image: url("Images/fade-bottom.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.mode-head { margin-top: 10px; }
.mode-label { font-size: 14px; color: var(--present); margin: 0; padding: 0; }
.mode-label--past { color: var(--past); }
.mode-label--future { color: var(--future); }
.mode-word { font-size: 62px; color: var(--ink); margin: -4px 0 0 0; padding: 0; }

.status { flex-direction: row; align-items: center; margin-top: 6px; }
.dot { width: 8px; height: 8px; border-radius: 4px; margin-right: 8px; }
.dot--good { background-color: var(--good); }
.dot--low  { background-color: var(--low); }
.dot--none { background-color: var(--none); }

.hint {
    align-self: center;
    font-size: 13px;
    color: var(--muted);
    white-space: normal;
    -unity-text-align: middle-center;
    margin-bottom: 12px;
}

.actions {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}
.action-main { flex-grow: 1; margin: 0 10px; }

/* ---------- cursorul timpului ---------- */

.timebar {
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 26px;
    padding: 14px 18px 2px 18px;
}

.time-slider { height: 36px; justify-content: center; }

.time-track {
    height: 6px;
    border-radius: 3px;
    background-image: url("Images/track.png");
    -unity-background-scale-mode: stretch-to-fill;
}

.year-dot {
    position: absolute;
    top: -2px;
    width: 10px;
    height: 10px;
    border-radius: 5px;
    background-color: var(--past-icon);
    translate: -50% 0;
}
.year-dot--1900 { left: 7%; }
.year-dot--1918 { left: 20%; }
.year-dot--1989 {
    left: 35%;
    top: -4px;
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 2px;
    border-color: var(--surface);
    background-color: var(--lilac);
}

.time-knob {
    position: absolute;
    top: -14px;
    left: 50%;
    width: 34px;
    height: 34px;
    border-radius: 17px;
    border-width: 4px;
    background-color: var(--surface);
    align-items: center;
    justify-content: center;
    translate: -50% 0;
    transition-property: left;
    transition-duration: 0.25s;
    transition-timing-function: ease-out-cubic;
}
.time-knob--dragging { transition-duration: 0s; }
.knob-core { width: 10px; height: 10px; border-radius: 5px; }

.knob--past { border-color: var(--past-icon); }
.knob--past .knob-core { background-color: var(--past-icon); }
.knob--present { border-color: var(--coral); }
.knob--present .knob-core { background-color: var(--coral); }
.knob--future { border-color: var(--future-icon); }
.knob--future .knob-core { background-color: var(--future-icon); }

.time-labels {
    flex-direction: row;
    justify-content: space-between;
    margin: 0 -6px;
}

.time-label,
.time-label:hover,
.time-label:active {
    width: 110px;
    height: 36px;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: #8C88A5;
    font-size: 15px;
    -unity-text-align: middle-center;
}
.time-label--serif { font-size: 16px; }
.time-label--left { -unity-text-align: middle-left; }
.time-label--right { -unity-text-align: middle-right; }
.time-label--active { color: var(--ink); }
.time-label--past-active { color: var(--past); }
.time-label--future-active { color: var(--future); }

/* ---------- meniu ---------- */

.list-item,
.list-item:hover {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 60px;
    margin: 14px 0 0 0;
    padding: 0 18px;
    border-width: 1px;
    border-color: var(--line);
    border-radius: 20px;
    background-color: var(--surface);
}
.list-item:active { background-color: var(--bg); }
.list-item__text { font-size: 16px; color: var(--ink); margin: 0; padding: 0; }

/* ---------- „Lasă o urmă” ---------- */

.sheet-dim,
.sheet-dim:hover,
.sheet-dim:active {
    position: absolute;
    left: 0; top: 0; right: 0; bottom: 0;
    margin: 0;
    border-width: 0;
    border-radius: 0;
    background-color: rgba(31, 58, 95, 0.3);
    opacity: 1;
    transition-property: opacity;
    transition-duration: 0.5s;
}
.sheet-dim--hidden { opacity: 0; }

.trace-sheet {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    height: 88%;
    background-color: var(--surface);
    border-top-left-radius: 30px;
    border-top-right-radius: 30px;
    padding: 10px 20px 26px 20px;
    translate: 0 0;
    transition-property: translate;
    transition-duration: 0.6s;
    transition-timing-function: ease-out-cubic;
}
.trace-sheet--closed { translate: 0 100%; }

.sheet-handle {
    align-self: center;
    width: 40px;
    height: 5px;
    border-radius: 3px;
    background-color: var(--line);
    margin-bottom: 4px;
}

.field-label {
    -unity-font: url("Fonts/Figtree-SemiBold.ttf");
    -unity-font-definition: initial;
    font-size: 13px;
    color: var(--muted);
    margin: 14px 0 6px 0;
    padding: 0;
}

.segments {
    flex-direction: row;
    background-color: var(--peach-soft);
    border-radius: 22px;
    padding: 4px;
    margin-top: 10px;
}
.seg,
.seg:hover,
.seg:active {
    flex-grow: 1;
    flex-basis: 0;
    height: 36px;
    margin: 0;
    padding: 0;
    border-width: 0;
    border-radius: 18px;
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
    font-size: 14px;
    -unity-font: url("Fonts/Figtree-SemiBold.ttf");
    -unity-font-definition: initial;
    -unity-text-align: middle-center;
}
.seg--active,
.seg--active:hover,
.seg--active:active {
    background-color: var(--surface);
    color: var(--ink);
}

.trace-input {
    margin: 0;
    padding: 0;
    height: 84px;
}
.trace-input > .unity-base-text-field__input,
.trace-input .unity-text-field__input {
    background-color: var(--peach-soft);
    border-width: 1px;
    border-color: var(--peach-line);
    border-radius: 16px;
    padding: 10px 14px;
    color: var(--ink);
    font-size: 17px;
    white-space: normal;
    -unity-font: url("Fonts/Fraunces-Medium.ttf");
    -unity-font-definition: initial;
    -unity-text-align: upper-left;
}

.chips { flex-direction: row; margin: 0 -4px; }
.chip,
.chip:hover,
.chip:active {
    flex-grow: 1;
    flex-basis: 0;
    height: 66px;
    margin: 0 4px;
    padding: 0;
    border-width: 2px;
    border-color: var(--line);
    border-radius: 18px;
    background-color: var(--surface);
    align-items: center;
    justify-content: center;
}
.chip__icon { width: 30px; height: 30px; -unity-background-scale-mode: scale-to-fit; }
.chip__label {
    -unity-font: url("Fonts/Fraunces-Italic.ttf");
    -unity-font-definition: initial;
    font-size: 14px;
    color: var(--ink);
    margin: 0;
    padding: 0;
}
.chip--joy.chip--active     { background-color: #FFF4D6; border-color: #F5B83D; }
.chip--sadness.chip--active { background-color: #E5EFFC; border-color: #5B95E6; }
.chip--longing.chip--active { background-color: #F1EAFF; border-color: #9C78E3; }

.trace-preview {
    flex-grow: 1;
    min-height: 90px;
    margin: 12px 0;
    border-radius: 20px;
    background-color: var(--peach-soft);
    align-items: center;
    justify-content: center;
}
.trace-shape {
    -unity-background-scale-mode: scale-to-fit;
    transition-property: width, height;
    transition-duration: 0.4s;
    transition-timing-function: ease-out-back;
}
.trace-shape--0 { width: 72px;  height: 72px; }
.trace-shape--1 { width: 100px; height: 100px; }
.trace-shape--2 { width: 128px; height: 128px; }

.shape--joy-0 { background-image: url("Images/Emotions/joy-0.png"); }
.shape--joy-1 { background-image: url("Images/Emotions/joy-1.png"); }
.shape--joy-2 { background-image: url("Images/Emotions/joy-2.png"); }
.shape--sadness-0 { background-image: url("Images/Emotions/sadness-0.png"); }
.shape--sadness-1 { background-image: url("Images/Emotions/sadness-1.png"); }
.shape--sadness-2 { background-image: url("Images/Emotions/sadness-2.png"); }
.shape--longing-0 { background-image: url("Images/Emotions/longing-0.png"); }
.shape--longing-1 { background-image: url("Images/Emotions/longing-1.png"); }
.shape--longing-2 { background-image: url("Images/Emotions/longing-2.png"); }

.suggestion { margin: 8px 0 0 2px; }

/* Urmele desenate peste ilustrație, în simulare */
.sim-trace { position: absolute; align-items: center; translate: -50% -50%; }
.sim-trace__shape { -unity-background-scale-mode: scale-to-fit; }
.sim-trace__label {
    -unity-font: url("Fonts/Fraunces-Italic.ttf");
    -unity-font-definition: initial;
    font-size: 12px;
    color: var(--ink);
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 9px;
    padding: 1px 8px;
    margin: -4px 0 0 0;
}

/* ---------- jurnalul de test ---------- */

.topbar-spacer { width: 44px; }
.log-intro { margin: 8px 0 10px 0; }
.log-scroll {
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 18px;
    padding: 12px 14px;
}
.log-text {
    font-size: 13px;
    color: var(--ink);
    white-space: normal;
    margin: 0;
    padding: 0;
}
.log-actions { margin-top: 12px; }

/* ---------- ecranul unei urme ---------- */

.detail-card {
    position: absolute;
    left: 12px; right: 12px; bottom: 12px;
    background-color: var(--surface);
    border-radius: 28px;
    padding: 22px 22px 12px 22px;
    opacity: 1;
    translate: 0 0;
    transition-property: translate, opacity;
    transition-duration: 0.45s;
    transition-timing-function: ease-out-cubic;
}
.detail-card--closed { translate: 0 40px; opacity: 0; }

.detail-shape { width: 56px; height: 56px; margin-right: 12px; -unity-background-scale-mode: scale-to-fit; }
.detail-emotion {
    -unity-font: url("Fonts/Fraunces-Italic.ttf");
    -unity-font-definition: initial;
    font-size: 22px;
    margin: 0; padding: 0;
}
.detail-emotion--joy     { color: #B9780F; }
.detail-emotion--sadness { color: #3B73C2; }
.detail-emotion--longing { color: #7454C2; }

.detail-text {
    -unity-font: url("Fonts/Fraunces-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 20px;
    color: var(--ink);
    white-space: normal;
    margin: 14px 0 10px 0;
    padding: 0;
}
.detail-actions { margin-top: 16px; }

.btn--dark,
.btn--dark:hover {
    background-color: var(--ink);
    color: #FFFFFF;
}
.btn--dark:active { background-color: #2B4A73; }
.btn:disabled { opacity: 0.55; }


/* ---------- toast ---------- */

.toast {
    position: absolute;
    left: 24px;
    right: 24px;
    bottom: 220px;
    padding: 12px 18px;
    border-radius: 18px;
    background-color: var(--ink);
    color: #FFFFFF;
    font-size: 14px;
    white-space: normal;
    -unity-text-align: middle-center;
}

/* ---------- animații ---------- */

/* Elementele cu .intro pornesc ascunse; UIRouter scoate clasa ca să intre în scenă. */
.intro {
    opacity: 0;
    translate: 0 10px;
}
.intro--scale { scale: 0.92 0.92; translate: 0 0; }

.mode-row,
.btn,
.logo,
.splash-tagline {
    transition-property: opacity, translate, scale;
    transition-duration: 0.5s;
    transition-timing-function: ease-out-cubic;
}

/* Trecerea între ecrane */
.screen {
    transition-property: opacity;
    transition-duration: 0.35s;
    transition-timing-function: ease-out-sine;
}
.screen--enter { opacity: 0; }

/* Schimbarea cuvântului mare când muți cursorul */
.mode-word,
.mode-label {
    transition-property: opacity, translate;
    transition-duration: 0.18s;
    transition-timing-function: ease-out-sine;
}
.word-out { opacity: 0; translate: 0 8px; }
.fade-hidden { opacity: 0; }

/* ---------- poza și vocea unei urme ---------- */

.media-panel { margin-top: 12px; }
.media-btn,
.media-btn:hover { font-size: 15px; padding: 0 8px; }

.photo-thumb {
    width: 96px;
    height: 96px;
    border-radius: 18px;
    background-color: var(--peach-soft);
    -unity-background-scale-mode: scale-and-crop;
    flex-shrink: 0;
}
.media-info { margin-left: 14px; align-items: flex-start; }
.media-title {
    -unity-font: url("Fonts/Fraunces-Italic.ttf");
    -unity-font-definition: initial;
    font-size: 18px;
    color: var(--ink);
    margin: 0 0 8px 0;
    padding: 0;
}
.media-redo { margin: 0; }

.voice-record { width: 100%; }
.voice-record--on,
.voice-record--on:hover {
    background-color: var(--present-tint);
    border-color: var(--coral);
    color: var(--present);
}
.voice-duration { margin: 0 12px; -unity-text-align: middle-center; }

.trace-input--short { height: 52px; }

.detail-photo {
    height: 240px;
    margin-top: 14px;
    border-radius: 18px;
    background-color: var(--bg);
    -unity-background-scale-mode: scale-to-fit;
}
.detail-voice { margin-top: 14px; }

/* ---------- fotografierea ---------- */

.capture-frame { background-color: #000000; overflow: hidden; }
.capture-preview { position: absolute; }

.capture-bar {
    position: absolute;
    left: 0; right: 0; bottom: 0;
    padding: 18px 24px 34px 24px;
    background-color: rgba(31, 58, 95, 0.35);
    align-items: center;
}
.capture-hint {
    font-size: 15px;
    color: #FFFFFF;
    margin: 0 0 14px 0;
    padding: 0;
    -unity-text-align: middle-center;
}
.capture-controls { width: 100%; justify-content: space-between; }
.capture-spacer { width: 52px; height: 52px; }
.capture-shutter,
.capture-shutter:hover {
    width: 76px;
    height: 76px;
    margin: 0;
    padding: 0;
    border-radius: 38px;
    border-width: 4px;
    border-color: #FFFFFF;
    background-color: rgba(0, 0, 0, 0);
    align-items: center;
    justify-content: center;
}
.capture-shutter__inner {
    width: 60px;
    height: 60px;
    border-radius: 30px;
    background-color: var(--coral);
}
.capture-shutter:active .capture-shutter__inner { background-color: var(--coral-pressed); }

/* ---------- meniu: serverul ---------- */

.server-label { margin-top: 24px; }
.server-input { margin: 0; padding: 0; height: 44px; }
.server-input > .unity-base-text-field__input,
.server-input .unity-text-field__input {
    background-color: var(--surface);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 14px;
    padding: 0 12px;
    font-size: 15px;
    color: var(--ink);
}
.server-status { margin-top: 8px; }

/* ---------- harta ---------- */

.map-view { background-color: #F2F2EF; overflow: hidden; }
.map-tile {
    position: absolute;
    -unity-background-scale-mode: stretch-to-fill;
}
.map-marker {
    position: absolute;
    width: 30px;
    height: 30px;
    translate: -50% -50%;
}
.map-marker__shape {
    position: absolute;
    left: 0; top: 0;
    width: 30px;
    height: 30px;
    -unity-background-scale-mode: scale-to-fit;
}
/* Urmele tale au un inel corai în jur. */
.map-marker--mine {
    border-width: 2px;
    border-color: var(--coral);
    border-radius: 17px;
}
.map-me {
    position: absolute;
    width: 18px;
    height: 18px;
    translate: -50% -50%;
    border-radius: 9px;
    border-width: 3px;
    border-color: #FFFFFF;
    background-color: var(--ink);
}
.map-status {
    flex-grow: 1;
    margin: 0 10px;
    padding: 8px 12px;
    font-size: 13px;
    color: var(--ink);
    white-space: normal;
    -unity-text-align: middle-center;
    background-color: rgba(255, 255, 255, 0.9);
    border-radius: 16px;
}
.map-controls { align-self: flex-end; margin-bottom: 10px; }
.map-control,
.map-control:hover {
    margin-top: 8px;
    font-size: 22px;
    color: var(--ink);
    -unity-text-align: middle-center;
}
.map-locate-dot {
    width: 14px;
    height: 14px;
    border-radius: 7px;
    border-width: 3px;
    border-color: var(--ink);
}
.map-attribution {
    align-self: flex-end;
    font-size: 10px;
    color: var(--muted);
    background-color: rgba(255, 255, 255, 0.8);
    border-radius: 6px;
    padding: 1px 6px;
    margin: 0 0 8px 0;
}
.map-card {
    background-color: var(--surface);
    border-radius: 26px;
    padding: 16px 18px 14px 18px;
}
.map-card__holder { width: 52px; height: 52px; margin-right: 12px; }
.map-card__shape {
    position: absolute;
    left: 0; top: 0;
    width: 52px;
    height: 52px;
    -unity-background-scale-mode: scale-to-fit;
}
.map-card__text { justify-content: center; }
.map-card__distance { margin: 12px 0 4px 0; }
.map-card__open { margin-top: 12px; }

/* ---------- emoții libere (alese de AI) ---------- */

.emotion-custom { margin-top: 8px; }
.emotion-custom .server-input { height: 40px; }
/* Mai puțin loc pentru cipuri și previzualizare, ca să încapă și rândul „Altă emoție”. */
.chip,
.chip:hover,
.chip:active { height: 58px; }
.trace-preview { min-height: 70px; }
.chip__label { white-space: nowrap; overflow: hidden; text-overflow: ellipsis; max-width: 96%; }

/* ---------- Time postcard ---------- */

.postcard-dim { background-color: rgba(31, 58, 95, 0.55); }
.postcard-card {
    width: 100%;
    background-color: #FFFDF8;
    padding: 12px 12px 14px 12px;
    border-radius: 6px;   /* fără rotire: cartea se salvează exact cum e pe ecran, ca dreptunghi */
}
.postcard-photo {
    height: 380px;
    border-radius: 3px;
    background-color: var(--bg);
    -unity-background-scale-mode: scale-and-crop;
}
.postcard-caption { margin-top: 12px; align-items: flex-end; }
.postcard-word {
    -unity-font: url("Fonts/Fraunces-Medium.ttf");
    -unity-font-definition: initial;
    font-size: 40px;
    color: var(--ink);
    margin: 0;
    padding: 0;
}
.postcard-meta { font-size: 12px; color: var(--muted); margin: 0; padding: 0; }
.postcard-right { align-items: flex-end; }
.postcard-emotions { justify-content: flex-end; margin-bottom: 2px; }
.postcard-emotion {
    width: 26px;
    height: 26px;
    margin-left: 2px;
    -unity-background-scale-mode: scale-to-fit;
}
.postcard-count { margin-bottom: 6px; }
.postcard-logo .logo__three,
.postcard-logo .logo__times { font-size: 20px; }
.postcard-saved {
    width: 100%;
    flex-grow: 1;
    -unity-background-scale-mode: scale-to-fit;
}
.postcard-actions { margin-top: 12px; }

.postcards-empty { margin: 12px 0; }
.postcards-grid { flex-direction: row; flex-wrap: wrap; justify-content: space-between; }
.postcard-thumb,
.postcard-thumb:hover,
.postcard-thumb:active {
    width: 48%;
    height: 220px;
    margin: 0 0 12px 0;
    padding: 0;
    border-width: 0;
    border-radius: 8px;
    background-color: var(--surface);
    -unity-background-scale-mode: scale-to-fit;
}
